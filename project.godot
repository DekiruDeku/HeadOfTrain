; Minimal browser prototype. Open this file in Godot 4.7.2.
config_version=5

[application]
config/name="Начальник рейса"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Первый контрольный запуск: вагон, кнопка и ответ API."

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.937, 0.937, 0.91, 1)

[audio]
driver/enable_input=false
