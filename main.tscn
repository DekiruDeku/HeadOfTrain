[gd_scene load_steps=14 format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]
[ext_resource type="PackedScene" path="res://scenes/start_screen.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/trip_screen.tscn" id="4"]
[ext_resource type="PackedScene" path="res://scenes/decision.tscn" id="5"]
[ext_resource type="PackedScene" path="res://scenes/debrief.tscn" id="6"]
[ext_resource type="Script" path="res://scripts/session_api.gd" id="7"]
[ext_resource type="Script" path="res://scripts/ui_diagnostics.gd" id="8"]
[ext_resource type="PackedScene" path="res://scenes/report.tscn" id="9"]
[ext_resource type="PackedScene" path="res://scenes/profile.tscn" id="10"]
[ext_resource type="PackedScene" path="res://scenes/leaderboard.tscn" id="11"]
[ext_resource type="PackedScene" path="res://scenes/notifications.tscn" id="12"]
[ext_resource type="PackedScene" path="res://scenes/progress_api.tscn" id="13"]

[node name="HeadOfTrain" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.88, 0.89, 0.85, 1)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="Connection" type="PanelContainer" parent="Layout"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Layout/Connection"]
layout_mode = 2

[node name="ConnectionText" type="Label" parent="Layout/Connection/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Small"
text = "Восстанавливаем сохранённую попытку…"
autowrap_mode = 3

[node name="Retry" type="Button" parent="Layout/Connection/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "Восстановить связь"
autowrap_mode = 3

[node name="Navigation" type="HFlowContainer" parent="Layout"]
layout_mode = 2
alignment = 1

[node name="Trip" type="Button" parent="Layout/Navigation"]
layout_mode = 2
text = "Рейс"

[node name="Report" type="Button" parent="Layout/Navigation"]
layout_mode = 2
text = "Отчёты"

[node name="Profile" type="Button" parent="Layout/Navigation"]
layout_mode = 2
text = "Профиль"

[node name="Leaderboard" type="Button" parent="Layout/Navigation"]
layout_mode = 2
text = "Рейтинг"

[node name="Notifications" type="Button" parent="Layout/Navigation"]
layout_mode = 2
text = "Уведомления"

[node name="Screens" type="TabContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0
tabs_visible = false
all_tabs_in_front = false

[node name="StartScreen" parent="Layout/Screens" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2

[node name="TripScreen" parent="Layout/Screens" instance=ExtResource("4")]
unique_name_in_owner = true
layout_mode = 2

[node name="Decision" parent="Layout/Screens" instance=ExtResource("5")]
unique_name_in_owner = true
layout_mode = 2

[node name="Debrief" parent="Layout/Screens" instance=ExtResource("6")]
unique_name_in_owner = true
layout_mode = 2

[node name="Report" parent="Layout/Screens" instance=ExtResource("9")]
unique_name_in_owner = true
layout_mode = 2

[node name="Profile" parent="Layout/Screens" instance=ExtResource("10")]
unique_name_in_owner = true
layout_mode = 2

[node name="Leaderboard" parent="Layout/Screens" instance=ExtResource("11")]
unique_name_in_owner = true
layout_mode = 2

[node name="Notifications" parent="Layout/Screens" instance=ExtResource("12")]
unique_name_in_owner = true
layout_mode = 2

[node name="ProgressAPI" parent="." instance=ExtResource("13")]

[node name="SessionAPI" type="Node" parent="."]
script = ExtResource("7")

[node name="HTTPRequest" type="HTTPRequest" parent="SessionAPI"]
timeout = 8.0
body_size_limit = 1048576

[node name="Poll" type="Timer" parent="SessionAPI"]
wait_time = 1.0
autostart = true

[node name="UIDiagnostics" type="Node" parent="."]
script = ExtResource("8")

[connection signal="pressed" from="Layout/Connection/Content/Retry" to="." method="_on_health"]
[connection signal="start_requested" from="Layout/Screens/StartScreen" to="." method="_on_start"]
[connection signal="health_requested" from="Layout/Screens/StartScreen" to="." method="_on_health"]
