[connection signal="back_requested" from="Layout/Screens/TripScreen" to="." method="_on_back_to_start"]
[connection signal="choice_selected" from="Layout/Screens/Decision" to="." method="_on_choice_selected"]
[connection signal="cancelled" from="Layout/Screens/Decision" to="." method="_on_back_to_trip"]
