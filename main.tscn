[connection signal="replay_requested" from="Layout/Screens/Profile" to="." method="_on_back_to_start"]
[connection signal="list_requested" from="Layout/Screens/Leaderboard" to="." method="_load_leaderboard"]
[connection signal="replay_requested" from="Layout/Screens/Leaderboard" to="." method="_on_back_to_start"]
[connection signal="list_requested" from="Layout/Screens/Notifications" to="." method="_load_notifications"]
[connection signal="replay_requested" from="Layout/Screens/Notifications" to="." method="_on_back_to_start"]
[connection signal="loading" from="ProgressAPI" to="." method="_on_progress_loading"]
[connection signal="received" from="ProgressAPI" to="." method="_on_progress_received"]
[connection signal="failed" from="ProgressAPI" to="." method="_on_progress_failed"]
