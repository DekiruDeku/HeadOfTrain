[connection signal="continue_requested" from="Layout/Screens/Debrief" to="." method="_on_continue"]
[connection signal="changed" from="SessionAPI" to="." method="_on_api_changed"]
[connection signal="state_received" from="SessionAPI" to="." method="_on_state_received"]
[connection signal="report_received" from="SessionAPI" to="." method="_on_report_received"]
[connection signal="request_completed" from="SessionAPI/HTTPRequest" to="SessionAPI" method="_on_response"]
[connection signal="timeout" from="SessionAPI/Poll" to="SessionAPI" method="_on_poll"]
[connection signal="pressed" from="Layout/Navigation/Trip" to="." method="_on_back_to_start"]
[connection signal="pressed" from="Layout/Navigation/Report" to="." method="_open_reports"]
[connection signal="pressed" from="Layout/Navigation/Profile" to="." method="_open_profile"]
[connection signal="pressed" from="Layout/Navigation/Leaderboard" to="." method="_open_leaderboard"]
