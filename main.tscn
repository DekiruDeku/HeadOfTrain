[connection signal="replay_requested" from="Layout/Screens/Report" to="." method="_on_back_to_start"]
[connection signal="report_requested" from="Layout/Screens/Debrief" to="." method="_return_to_report"]
[connection signal="refresh_requested" from="Layout/Screens/Profile" to="." method="_open_profile"]
