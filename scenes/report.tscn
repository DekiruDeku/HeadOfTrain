[gd_scene load_steps=5 format=3]

[ext_resource type="PackedScene" path="res://scenes/progress_screen.tscn" id="1"]
[ext_resource type="Script" path="res://scripts/report.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/paged_records.tscn" id="3"]
[sub_resource type="ButtonGroup" id="Sections"]

[node name="Report" instance=ExtResource("1")]
script = ExtResource("2")

[node name="Title" parent="Margin/Content/Header/Text" index="1"]
text = "Рейс завершён"

[node name="Summary" type="Label" parent="Margin/Content/Body" index="0"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Итог сохранённой попытки"
autowrap_mode = 3

[node name="Metrics" type="GridContainer" parent="Margin/Content/Body" index="1"]
unique_name_in_owner = true
layout_mode = 2
columns = 2

[node name="LoyaltyPanel" type="PanelContainer" parent="Margin/Content/Body/Metrics"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Content" type="VBoxContainer" parent="Margin/Content/Body/Metrics/LoyaltyPanel"]
layout_mode = 2

[node name="Loyalty" type="Label" parent="Margin/Content/Body/Metrics/LoyaltyPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Лояльность · —"
autowrap_mode = 3

[node name="LoyaltyBar" type="ProgressBar" parent="Margin/Content/Body/Metrics/LoyaltyPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 14)
show_percentage = false

[node name="SafetyPanel" type="PanelContainer" parent="Margin/Content/Body/Metrics"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Content" type="VBoxContainer" parent="Margin/Content/Body/Metrics/SafetyPanel"]
layout_mode = 2

[node name="Safety" type="Label" parent="Margin/Content/Body/Metrics/SafetyPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Безопасность · —"
autowrap_mode = 3

[node name="SafetyBar" type="ProgressBar" parent="Margin/Content/Body/Metrics/SafetyPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 14)
show_percentage = false

[node name="Points" type="Label" parent="Margin/Content/Body" index="2"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Очки · ожидаем оценку сервера"
autowrap_mode = 3

[node name="Recommendation" type="Label" parent="Margin/Content/Body" index="3"]
unique_name_in_owner = true
layout_mode = 2
text = "Следующая тренировка · рекомендация сервера"
autowrap_mode = 3

[node name="Sections" type="GridContainer" parent="Margin/Content/Body" index="4"]
unique_name_in_owner = true
layout_mode = 2
columns = 4

[node name="Incidents" type="Button" parent="Margin/Content/Body/Sections"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("Sections")
text = "Обращения"

[node name="Violations" type="Button" parent="Margin/Content/Body/Sections"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("Sections")
text = "Нарушения"

[node name="Assessment" type="Button" parent="Margin/Content/Body/Sections"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("Sections")
text = "Оценки"

[node name="Events" type="Button" parent="Margin/Content/Body/Sections"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("Sections")
text = "Журнал"

[node name="Records" parent="Margin/Content/Body" index="5" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2

[node name="Debrief" type="Button" parent="Margin/Content/Body" index="6"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Разбор всех решений"
autowrap_mode = 3

[node name="Archive" type="VBoxContainer" parent="Margin/Content" index="2"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Content/Archive"]
layout_mode = 2
theme_type_variation = &"Section"
text = "Ранее открытые отчёты"
autowrap_mode = 3

[node name="Hint" type="Label" parent="Margin/Content/Archive"]
layout_mode = 2
theme_type_variation = &"Small"
text = "На этом устройстве сохраняются ссылки на полученные отчёты. Содержимое каждый раз загружается с сервера. Полный архив профиля доступен после подключения Б5."
autowrap_mode = 3

[node name="SavedReports" parent="Margin/Content/Archive" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2

[node name="ReportId" type="LineEdit" parent="Margin/Content/Archive"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
placeholder_text = "ID сохранённого рейса"
max_length = 32
accessibility_name = "ID сохранённого рейса"

[node name="OpenId" type="Button" parent="Margin/Content/Archive"]
layout_mode = 2
text = "Открыть отчёт по ID"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Content/Body/Sections/Incidents" to="." method="_select_section" binds=["incidents"]]
[connection signal="pressed" from="Margin/Content/Body/Sections/Violations" to="." method="_select_section" binds=["violations"]]
[connection signal="pressed" from="Margin/Content/Body/Sections/Assessment" to="." method="_select_section" binds=["assessment"]]
[connection signal="pressed" from="Margin/Content/Body/Sections/Events" to="." method="_select_section" binds=["events"]]
[connection signal="pressed" from="Margin/Content/Body/Debrief" to="." method="_on_debrief"]
[connection signal="activated" from="Margin/Content/Body/Records" to="." method="_on_evidence"]
[connection signal="activated" from="Margin/Content/Archive/SavedReports" to="." method="_on_report"]
[connection signal="pressed" from="Margin/Content/Archive/OpenId" to="." method="_on_open_id"]
[connection signal="text_submitted" from="Margin/Content/Archive/ReportId" to="." method="_on_report"]
