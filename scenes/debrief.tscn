[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/debrief.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]

[node name="Debrief" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 20

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Badge" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Small"
text = "РАЗБОР РЕШЕНИЙ · СОХРАНЁННЫЙ ЖУРНАЛ"
autowrap_mode = 3

[node name="Title" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Title"
text = "Рейс завершён · сохранённый разбор"
autowrap_mode = 3

[node name="Summary" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Здесь появится подтверждённый результат."
autowrap_mode = 3

[node name="Facts" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Факты и шкалы сервера"
autowrap_mode = 3

[node name="Pager" type="HBoxContainer" parent="Margin/Panel/Content"]
layout_mode = 2

[node name="Previous" type="Button" parent="Margin/Panel/Content/Pager"]
unique_name_in_owner = true
layout_mode = 2
text = "←"
accessibility_name = "Предыдущее решение"
custom_minimum_size = Vector2(48, 44)

[node name="PageLabel" type="Label" parent="Margin/Panel/Content/Pager"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
text = "Решение 1 / 1"
autowrap_mode = 3

[node name="Next" type="Button" parent="Margin/Panel/Content/Pager"]
unique_name_in_owner = true
layout_mode = 2
text = "→"
accessibility_name = "Следующее решение"
custom_minimum_size = Vector2(48, 44)

[node name="ChoiceTitle" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Section"
text = "Ваше действие"
autowrap_mode = 3

[node name="Choice" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Текст подтверждённого выбора"
autowrap_mode = 3

[node name="Effect" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Последствия из истории сервера"
autowrap_mode = 3

[node name="Explanation" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Объяснение решения"
autowrap_mode = 3

[node name="Recommendation" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Section"
text = "Рекомендация сервера"
autowrap_mode = 3

[node name="Evidence" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Small"
text = "Доказательство из журнала действий"
autowrap_mode = 2

[node name="Persistence" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Small"
text = "Состояние сохранения"
autowrap_mode = 3

[node name="TripId" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "trip_id"
autowrap_mode = 2

[node name="Continue" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Продолжить диалог"
autowrap_mode = 3

[node name="Back" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
theme_type_variation = &"RowButton"
text = "Вернуться к вагону"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Panel/Content/Pager/Previous" to="." method="_on_previous"]
[connection signal="pressed" from="Margin/Panel/Content/Pager/Next" to="." method="_on_next"]
[connection signal="pressed" from="Margin/Panel/Content/Continue" to="." method="_on_continue"]
[connection signal="pressed" from="Margin/Panel/Content/Back" to="." method="_on_back"]
