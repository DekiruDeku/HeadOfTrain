[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/debrief.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]

[node name="Debrief" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 24

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Badge" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Small"
text = "КРАТКИЙ РАЗБОР  /  ДЕМО A1"
autowrap_mode = 3

[node name="Title" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Title"
text = "Чемодан в проходе"
autowrap_mode = 3

[node name="ChoiceTitle" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Section"
text = "Выбранный вариант"
autowrap_mode = 3

[node name="Choice" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Уточнить обстоятельства и предложить помощь с размещением багажа."
autowrap_mode = 3

[node name="EffectTitle" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Section"
text = "Что показывает этот экран"
autowrap_mode = 3

[node name="Effect" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
text = "Выбранный вариант показан выше. В демонстрации нет оценки решения, начисления очков или изменения шкал."
autowrap_mode = 3

[node name="Persistence" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Выбор исчезнет после перезагрузки. Это предварительный просмотр: учебные последствия и сохранение разбора ещё не подключены."
autowrap_mode = 3

[node name="Back" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Вернуться к вагону"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Panel/Content/Back" to="." method="_on_back"]
