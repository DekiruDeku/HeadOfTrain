[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/decision.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]

[node name="Decision" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 24

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Badge" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_type_variation = &"Small"
text = "ПЕРВЫЙ СЦЕНАРИЙ · УЧЕБНЫЙ ЧЕРНОВИК"
autowrap_mode = 3

[node name="Title" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Title"
text = "Чемодан в проходе"
autowrap_mode = 3

[node name="Place" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Вагон № 2 · условие из сохранённой попытки"
autowrap_mode = 3

[node name="Description" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Пассажир оставил чемодан в проходе и переживает за сохранность вещей. Место для багажа ещё не проверено."
autowrap_mode = 3

[node name="Note" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Выберите действие. Последствия и оценки определяет сервер."
autowrap_mode = 3

[node name="Choice1" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "1. Уточнить обстоятельства и предложить помощь с размещением багажа."
alignment = 0
autowrap_mode = 3

[node name="Choice2" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "2. Попросить пассажира самостоятельно убрать чемодан."
alignment = 0
autowrap_mode = 3

[node name="Choice3" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "3. Оставить чемодан рядом с креслом до следующей остановки."
alignment = 0
autowrap_mode = 3

[node name="Cancel" type="Button" parent="Margin/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"RowButton"
text = "Вернуться к вагону"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Panel/Content/Choice1" to="." method="_on_choice" binds= [0]]
[connection signal="pressed" from="Margin/Panel/Content/Choice2" to="." method="_on_choice" binds= [1]]
[connection signal="pressed" from="Margin/Panel/Content/Choice3" to="." method="_on_choice" binds= [2]]
[connection signal="pressed" from="Margin/Panel/Content/Cancel" to="." method="_on_cancel"]
