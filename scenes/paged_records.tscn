[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/paged_records.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/progress_row.tscn" id="2"]

[node name="PagedRecords" type="VBoxContainer"]
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Empty" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Записей пока нет."
autowrap_mode = 3

[node name="Row1" parent="." instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="Row2" parent="." instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="Row3" parent="." instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="Pager" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Previous" type="Button" parent="Pager"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(48, 44)
text = "←"
accessibility_name = "Предыдущая страница"

[node name="PageLabel" type="Label" parent="Pager"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
text = "Страница 1 / 1"
autowrap_mode = 3

[node name="Next" type="Button" parent="Pager"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(48, 44)
text = "→"
accessibility_name = "Следующая страница"

[connection signal="pressed" from="Pager/Previous" to="." method="_on_previous"]
[connection signal="pressed" from="Pager/Next" to="." method="_on_next"]
[connection signal="activated" from="Row1" to="." method="_on_activated"]
[connection signal="activated" from="Row2" to="." method="_on_activated"]
[connection signal="activated" from="Row3" to="." method="_on_activated"]
