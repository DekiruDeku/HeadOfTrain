[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/start_screen.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]
[ext_resource type="Texture2D" path="res://assets/carriage.png" id="3"]

[sub_resource type="ButtonGroup" id="Condition"]

[node name="StartScreen" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Brand" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"Small"
text = "НР  /  НАЧАЛЬНИК РЕЙСА"
autowrap_mode = 3

[node name="Badge" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Small"
text = "ПОДКЛЮЧАЕМСЯ"
autowrap_mode = 3

[node name="Heading" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Ваш первый рейс"
autowrap_mode = 3

[node name="Introduction" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Всё начинается с одного вагона."
autowrap_mode = 3

[node name="Body" type="GridContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
columns = 2

[node name="ImageColumn" type="VBoxContainer" parent="Margin/Content/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Image" type="TextureRect" parent="Margin/Content/Body/ImageColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
texture = ExtResource("3")
expand_mode = 1
stretch_mode = 5

[node name="Caption" type="Label" parent="Margin/Content/Body/ImageColumn"]
layout_mode = 2
theme_type_variation = &"Small"
text = "02  /  ВАГОН «СТАНДАРТ»"
autowrap_mode = 3

[node name="Departure" type="PanelContainer" parent="Margin/Content/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Content" type="VBoxContainer" parent="Margin/Content/Body/Departure"]
layout_mode = 2
alignment = 1

[node name="Title" type="Label" parent="Margin/Content/Body/Departure/Content"]
layout_mode = 2
theme_type_variation = &"Section"
text = "Готовы к отправлению?"
autowrap_mode = 3

[node name="Description" type="Label" parent="Margin/Content/Body/Departure/Content"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Чемодан в проходе. Выберите условие тренировки; попытка и разбор сохраняются."
autowrap_mode = 3

[node name="ConditionTitle" type="Label" parent="Margin/Content/Body/Departure/Content"]
layout_mode = 2
text = "Условие демонстрационного сценария"
autowrap_mode = 3

[node name="Free" type="Button" parent="Margin/Content/Body/Departure/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
toggle_mode = true
button_pressed = true
button_group = SubResource("Condition")
text = "Место свободно"
autowrap_mode = 3

[node name="Occupied" type="Button" parent="Margin/Content/Body/Departure/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
toggle_mode = true
button_group = SubResource("Condition")
text = "Место занято"
autowrap_mode = 3

[node name="StartButton" type="Button" parent="Margin/Content/Body/Departure/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Начать рейс"
autowrap_mode = 3

[node name="Status" type="Label" parent="Margin/Content/Body/Departure/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Проверяем связь с сервером…"
autowrap_mode = 3

[node name="HealthButton" type="Button" parent="Margin/Content/Body/Departure/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"RowButton"
text = "Обновить состояние"
autowrap_mode = 3

[node name="DemoButton" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"RowButton"
text = "Открыть локальное демо"
autowrap_mode = 3

[node name="DemoNote" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"Small"
text = "Учебный черновик · один сценарий без таймера. Сохраняйте данные этого сайта в браузере, чтобы вернуться к своей попытке."
autowrap_mode = 3

[connection signal="pressed" from="Margin/Content/Body/Departure/Content/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Margin/Content/Body/Departure/Content/HealthButton" to="." method="_on_health_pressed"]
