[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/progress_screen.gd" id="1"]
[ext_resource type="Theme" path="res://theme/train_theme.tres" id="2"]

[node name="ProgressScreen" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="PanelContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Text" type="VBoxContainer" parent="Margin/Content/Header"]
layout_mode = 2

[node name="Badge" type="Label" parent="Margin/Content/Header/Text"]
layout_mode = 2
theme_type_variation = &"Small"
text = "НАЧАЛЬНИК РЕЙСА · УЧЕБНЫЙ ПРОГРЕСС"
autowrap_mode = 3

[node name="Title" type="Label" parent="Margin/Content/Header/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Title"
text = "Результаты тренировки"
autowrap_mode = 3

[node name="Subtitle" type="Label" parent="Margin/Content/Header/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Данные сохранённой попытки"
autowrap_mode = 3

[node name="Status" type="Label" parent="Margin/Content/Header/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Small"
text = "Данные ещё не загружены."
autowrap_mode = 3

[node name="Refresh" type="Button" parent="Margin/Content/Header/Text"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "Обновить"

[node name="Body" type="VBoxContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="Replay" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "К тренировке в двух вагонах"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Content/Header/Text/Refresh" to="." method="_on_refresh"]
[connection signal="pressed" from="Margin/Content/Replay" to="." method="_on_replay"]
